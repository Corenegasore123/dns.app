# Copy to .env.local for local development (npm run dev)

# NestJS API base URL. Server-only: the browser never calls the API directly.
API_URL=http://localhost:4000

# Public website. Product images (/images/...) are loaded from here, and "View website" links to it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The session cookie is `Secure` in production builds. Browsers accept that on http://localhost;
# set to false only if you serve a production build over plain http on another host.
# COOKIE_SECURE=false
